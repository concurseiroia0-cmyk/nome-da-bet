# Copie para .env e ajuste. DEMO - créditos fictícios, sem valor real.
DATABASE_URL="file:./dev.db?connection_limit=1"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
JWT_SECRET="dev-only-secret-troque-em-producao"
JWT_EXPIRES_IN="7d"
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RTP_TOLERANCE=0.01
# Opcional: serve o build do client pelo próprio server (npm run build && SERVE_CLIENT=1 npm start)
# SERVE_CLIENT=1
